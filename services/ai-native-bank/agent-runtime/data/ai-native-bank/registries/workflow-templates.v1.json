        { "id": "execute_repayment", "title": "执行信用卡还款", "dependsOn": ["confirm_repayment"], "requiredCapabilityIds": ["bank.credit-card.repayment.create"], "confirmationLevel": "transaction", "optional": false, "order": 6 },
        { "id": "verify_receipt", "title": "核验还款回执", "dependsOn": ["execute_repayment"], "requiredCapabilityIds": [], "confirmationLevel": "none", "optional": false, "order": 7 }
      ]
    },
    {
