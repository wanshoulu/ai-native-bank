{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-harbor.local/schemas/ai-native-bank/experience-scenario.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scenarios"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/scenario" }
    }
  },
  "$defs": {
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["signal", "operator", "value"],
          "properties": {
            "signal": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,95}$" },
            "operator": { "enum": ["eq", "ne", "gt", "gte", "lt", "lte", "in", "contains", "exists"] },
            "value": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["all"],
          "properties": { "all": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/condition" } } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any"],
          "properties": { "any": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/condition" } } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["not"],
          "properties": { "not": { "$ref": "#/$defs/condition" } }
        }
      ]
    },
    "catalogAction": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["channel", "item", "action"],
      "properties": {
        "channel": { "type": "string", "minLength": 1, "maxLength": 32 },
        "item": { "type": "string", "minLength": 1, "maxLength": 64 },
        "action": { "type": "string", "minLength": 1, "maxLength": 32 }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "title", "status", "type", "targetIntentId", "requiredSkillIds", "requiredCapabilityIds", "workflowTemplateId", "trigger", "surfaces", "cooldownHours", "action", "priority", "reasonCode", "reasonTextTemplate", "entryMessage", "legacyType", "catalogAction", "supersededBy", "reshowAfterHours"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,95}$" },
        "complianceClass": { "enum": ["service", "marketing", "risk"] },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "status": { "enum": ["active", "inactive"] },
        "type": { "enum": ["proactive_service", "next_intent", "care"] },
        "targetIntentId": { "type": ["string", "null"], "pattern": "^[a-z0-9.-]+$" },
        "requiredSkillIds": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^bank\\.[a-z0-9.-]+$" } },
        "requiredCapabilityIds": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^bank\\.[a-z0-9.-]+$" } },
        "workflowTemplateId": { "type": ["string", "null"], "pattern": "^[a-z0-9-]+-v[0-9]+$" },
        "trigger": { "$ref": "#/$defs/condition" },
        "surfaces": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "enum": ["home", "agent", "channel"] } },
        "cooldownHours": { "type": "integer", "minimum": 0, "maximum": 8760 },
        "action": { "enum": ["START_ASSISTANCE", "OPEN_CATALOG"] },
        "priority": { "enum": ["critical", "high", "normal", "low"] },
        "reasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,95}$" },
        "reasonTextTemplate": { "type": "string", "minLength": 1, "maxLength": 160 },
        "entryMessage": { "type": ["string", "null"], "minLength": 1, "maxLength": 240 },
        "legacyType": { "type": ["string", "null"], "maxLength": 64 },
        "supersededBy": { "type": ["string", "null"], "maxLength": 96 },
        "reshowAfterHours": { "type": ["integer", "null"], "minimum": 1, "maximum": 168 },
        "catalogAction": { "$ref": "#/$defs/catalogAction" }
      }
    }
  }
}
