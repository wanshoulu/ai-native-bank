{
  "schemaVersion": "1.0",
  "workflowTemplates": [
    {
      "id": "credit-card-repayment-v1", "version": "1.0.0", "title": "信用卡还款",
      "assistancePolicy": { "mode": "smart_companion", "activation": "on_user_start", "complexityReasons": ["multi_step", "high_impact"], "homeVisible": true, "maxInactiveHours": 24 },
      "steps": [
        { "id": "select_card", "title": "选择还款信用卡", "dependsOn": [], "requiredCapabilityIds": ["bank.credit-card.list"], "confirmationLevel": "none", "optional": false, "order": 1 },
        { "id": "choose_account", "title": "核对付款账户", "dependsOn": ["select_card"], "requiredCapabilityIds": ["bank.account.list"], "confirmationLevel": "plan", "optional": false, "order": 2 },
        { "id": "review_bill", "title": "核对账单与付款余额", "dependsOn": ["choose_account"], "requiredCapabilityIds": ["bank.credit-card.bill.get", "bank.account.balance.get"], "confirmationLevel": "none", "optional": false, "order": 3 },
        { "id": "choose_amount", "title": "选择还款金额", "dependsOn": ["review_bill"], "requiredCapabilityIds": [], "confirmationLevel": "plan", "optional": false, "order": 4 },
