# ai-native-bank 环境变量模板——复制为 .env 后填入真实值；.env 已被 .gitignore 排除，绝不提交

# ── 服务 ──
HOST=127.0.0.1
PORT=3000

# ── 云 LLM 密钥（对话智能/推荐走云模型时需要；不配则降级）──
QWEN_KEY=
DEEPSEEK_KEY=
GLM_KEY=
KIMI_KEY=
VOLCANO_KEY=  # 火山引擎（格式: id:secret）

# ── Python agent-runtime（不启动则对话走图引擎降级）──
AI_BANK_AGENT_RUNTIME_URL=http://127.0.0.1:18120

# ── 内部服务令牌（agent-runtime 回调主服务 /internal/* 用；生成随机串）──
AI_BANK_AGENT_RUNTIME_TOKEN=
# 或令牌文件路径（二选一）
AI_BANK_AGENT_RUNTIME_TOKEN_FILE=

# ── 容器部署时主服务自身地址（自引用模型网关）──
AI_BANK_INTERNAL_URL=http://localhost:3000
