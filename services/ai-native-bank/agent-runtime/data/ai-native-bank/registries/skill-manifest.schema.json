{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-harbor.local/schemas/ai-native-bank/skill-registry.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "skills"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "version", "digest", "status", "handledIntentIds",
          "intentCapabilityBindings", "businessObjectIds", "requiredCapabilityIds",
          "riskBoundary", "compatibleGraphVersions", "compatibleRuntimeVersions",
          "entrypoint", "owner"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^bank\\.[a-z0-9.-]+$" },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "status": { "enum": ["active", "disabled"] },
          "handledIntentIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "intentCapabilityBindings": { "type": "object", "additionalProperties": { "type": "array", "uniqueItems": true, "items": { "type": "string" } } },
          "businessObjectIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "requiredCapabilityIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "riskBoundary": { "enum": ["L0", "L1", "L2", "L3"] },
          "compatibleGraphVersions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "compatibleRuntimeVersions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "entrypoint": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
