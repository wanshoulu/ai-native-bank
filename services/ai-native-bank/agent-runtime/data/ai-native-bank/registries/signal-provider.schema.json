{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-harbor.local/schemas/ai-native-bank/signal-provider.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "signals"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "signals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "providerId", "valueType", "classification", "freshnessSeconds"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,95}$" },
          "providerId": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,95}$" },
          "valueType": { "enum": ["boolean", "integer", "number", "string", "string_array"] },
          "classification": { "enum": ["financial", "context", "preference", "workflow"] },
          "freshnessSeconds": { "type": "integer", "minimum": 1, "maximum": 2678400 }
        }
      }
    }
  }
}
