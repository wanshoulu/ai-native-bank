{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-native-bank/schemas/scenario-manifest.schema.json",
  "title": "AI Native Bank Scenario Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scenarios"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "version", "title", "domain", "owner", "status",
          "intentIds", "menuIds", "requiredCapabilityIds", "evalDatasetId"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "domain": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
          "owner": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
          "status": { "enum": ["active", "planned", "retired"] },
          "intentIds": {
            "type": "array", "maxItems": 64, "uniqueItems": true,
            "items": { "type": "string", "pattern": "^ccb\\.[a-z0-9.-]+$" }
          },
          "menuIds": {
            "type": "array", "maxItems": 32, "uniqueItems": true,
            "items": { "type": "string", "pattern": "^ccb\\.menu\\.[a-z0-9.-]+$" }
          },
          "requiredCapabilityIds": {
            "type": "array", "maxItems": 64, "uniqueItems": true,
            "items": { "type": "string", "pattern": "^bank\\.[a-z0-9.-]+$" }
          },
          "evalDatasetId": { "type": ["string", "null"], "maxLength": 128 }
        }
      }
    }
  }
}
