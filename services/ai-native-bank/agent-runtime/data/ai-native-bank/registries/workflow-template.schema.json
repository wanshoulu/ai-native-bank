{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-harbor.local/schemas/ai-native-bank/workflow-template.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workflowTemplates"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "workflowTemplates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "title", "steps"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+-v[0-9]+$" },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "title", "dependsOn", "requiredCapabilityIds", "confirmationLevel", "optional", "order"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$" },
                "title": { "type": "string", "minLength": 1, "maxLength": 80 },
                "dependsOn": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$" } },
                "requiredCapabilityIds": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^bank\\.[a-z0-9.-]+$" } },
                "confirmationLevel": { "enum": ["none", "plan", "transaction"] },
                "optional": { "type": "boolean" },
                "order": { "type": "integer", "minimum": 1, "maximum": 32 }
              }
            }
          }
        }
      }
    }
  }
}
